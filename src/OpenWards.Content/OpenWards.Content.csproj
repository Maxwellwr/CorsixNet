<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Builds simulation state from game data: levels, and later content definitions and mods.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenWards.Content.Tests" />
    <InternalsVisibleTo Include="OpenWards.LuaConverter" />
  </ItemGroup>

  <ItemGroup>
    <!-- The language files beside the game: CorsixTH's translations (CorsixTH/Lua/languages, MIT) as YAML in Languages,
         OpenWards's own strings in Languages/OpenWards; read by CorsixLanguages. -->
    <None Include="Languages/**/*.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The announcer's speech in other languages, Languages/Voice/<language>, read by LanguageVoice. -->
    <None Include="Languages/Voice/**/*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenWards.Formats/OpenWards.Formats.csproj" />
    <ProjectReference Include="../OpenWards.Sim/OpenWards.Sim.csproj" />
  </ItemGroup>

</Project>
