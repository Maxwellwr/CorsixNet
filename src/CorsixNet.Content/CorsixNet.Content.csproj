<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Builds simulation state from game data: levels, and later content definitions and mods.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CorsixNet.Content.Tests" />
    <InternalsVisibleTo Include="CorsixNet.LuaConverter" />
  </ItemGroup>

  <ItemGroup>
    <!-- The language files beside the game: CorsixTH's translations (CorsixTH/Lua/languages, MIT) as YAML in Languages,
         CorsixNet's own strings in Languages/CorsixNet; read by CorsixLanguages. -->
    <None Include="Languages/**/*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CorsixNet.Formats/CorsixNet.Formats.csproj" />
    <ProjectReference Include="../CorsixNet.Sim/CorsixNet.Sim.csproj" />
  </ItemGroup>

</Project>
