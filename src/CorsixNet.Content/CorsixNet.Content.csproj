<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Builds simulation state from game data: levels, and later content definitions and mods.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CorsixNet.Content.Tests" />
    <InternalsVisibleTo Include="CorsixNet.LuaConverter" />
  </ItemGroup>

  <ItemGroup>
    <!-- CorsixTH's language files (CorsixTH/Lua/languages, MIT) as YAML, read by CorsixLanguages. -->
    <None Include="Languages/CorsixTH/*.yaml" Link="Languages/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- CorsixNet's own interface strings in the same form, laid over CorsixTH's by CorsixLanguages. -->
    <None Include="Languages/CorsixNet/*.yaml" Link="Languages/CorsixNet/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CorsixNet.Formats/CorsixNet.Formats.csproj" />
    <ProjectReference Include="../CorsixNet.Sim/CorsixNet.Sim.csproj" />
  </ItemGroup>

</Project>
