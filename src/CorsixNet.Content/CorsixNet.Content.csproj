<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Builds simulation state from game data: levels, and later content definitions and mods.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CorsixNet.Content.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- CorsixTH's language files (CorsixTH/Lua/languages, MIT), read by CorsixLanguages. -->
    <None Include="Languages/CorsixTH/*.lua" Link="Languages/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CorsixNet.Formats/CorsixNet.Formats.csproj" />
    <ProjectReference Include="../CorsixNet.Sim/CorsixNet.Sim.csproj" />
  </ItemGroup>

</Project>
