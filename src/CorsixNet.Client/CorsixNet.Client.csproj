<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CorsixNet</AssemblyName>
    <RootNamespace>CorsixNet.Client</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="MeltySynth" />
    <PackageReference Include="NLayer" />
    <PackageReference Include="Concentus" />
    <PackageReference Include="Concentus.Oggfile" />
    <PackageReference Include="FreeTypeSharp" />
    <PackageReference Include="StbTrueTypeSharp" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/aux_ui.tab" LogicalName="CorsixNet.Client.Assets.aux_ui.tab" />
    <EmbeddedResource Include="Assets/aux_ui.dat" LogicalName="CorsixNet.Client.Assets.aux_ui.dat" />
    <EmbeddedResource Include="Assets/lose.pl8" LogicalName="CorsixNet.Client.Assets.lose.pl8" />
    <EmbeddedResource Include="Assets/tree_ctrl.*" LogicalName="CorsixNet.Client.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/mainmenu*.dat.gz" LogicalName="CorsixNet.Client.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/mainmenu*.pal" LogicalName="CorsixNet.Client.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CorsixNet.Client.Tests" />
    <ProjectReference Include="../CorsixNet.Content/CorsixNet.Content.csproj" />
    <ProjectReference Include="../CorsixNet.Formats/CorsixNet.Formats.csproj" />
    <ProjectReference Include="../CorsixNet.Net/CorsixNet.Net.csproj" />
    <ProjectReference Include="../CorsixNet.Sim/CorsixNet.Sim.csproj" />
  </ItemGroup>

</Project>
