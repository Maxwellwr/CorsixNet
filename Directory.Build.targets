<Project>
  <ItemGroup Condition="'$(OpenWardsDeterministic)' == 'true'">
    <CompilerVisibleProperty Include="OpenWardsDeterministic" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/OpenWards.Analyzers/OpenWards.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
