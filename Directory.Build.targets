<Project>
  <ItemGroup Condition="'$(CorsixNetDeterministic)' == 'true'">
    <CompilerVisibleProperty Include="CorsixNetDeterministic" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/CorsixNet.Analyzers/CorsixNet.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
