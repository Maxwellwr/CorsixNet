<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Projects whose code runs inside the lockstep simulation set
    CorsixNetDeterministic=true. The determinism analyzer is attached to
    them in Directory.Build.targets.
  -->
  <PropertyGroup>
    <CorsixNetDeterministic Condition="'$(CorsixNetDeterministic)' == ''">false</CorsixNetDeterministic>
  </PropertyGroup>
</Project>
